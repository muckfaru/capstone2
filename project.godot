; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="capstone"
run/main_scene="res://scene/loadingAni.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Auth="*res://scene/auth.tscn"
ChatManager="*res://script/ChatManager.gd"
MultiplayerConfig="*res://script/MultiplayerConfig.gd"
ForceNetworkMode="*res://script/ForceNetworkMode.gd"
TutorialManager="*res://script/TutorialManager.gd"
DialogueManager="*res://script/dialogue_manager.gd"
GlobalState="*res://script/GlobalState.gd"
InventoryHelper="*res://script/InventoryHelper.gd"
SettingsManager="*res://script/SettingsManager.gd"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="capstone"

[editor_plugins]

enabled=PackedStringArray()

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/use_taa=true
