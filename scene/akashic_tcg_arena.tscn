[sub_resource type="Shader" id="Shader_timer_gradient"]
code = "shader_type canvas_item;

uniform vec4 top_color : source_color = vec4(0.0, 1.0, 1.0, 1.0);
uniform vec4 bottom_color : source_color = vec4(0.0, 1.0, 0.45, 1.0);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);	
	// Per-glyph vertical gradient: cyan (top) -> green (bottom).
	vec4 grad = mix(top_color, bottom_color, UV.y);
	COLOR = tex * grad;
}
"

