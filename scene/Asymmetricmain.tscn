[node name="GlossaryText" type="RichTextLabel" parent="GlossaryPanel/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Public Key[/b] - A cryptographic key that can be shared openly. Used to ENCRYPT messages.

[b]Private Key[/b] - A secret key that must never be shared. Used to DECRYPT messages encrypted with the corresponding public key.

[b]Asymmetric Encryption[/b] - Encryption that uses two different keys (public and private) instead of one shared key.

[b]Symmetric Encryption[/b] - Encryption that uses the same key for both encryption and decryption.

[b]Key Pair[/b] - The combination of a public key and its matching private key.

[b]Encryption[/b] - The process of scrambling data so only authorized parties can read it.

[b]Decryption[/b] - The process of unscrambling encrypted data back to its original form.

[b]RSA[/b] - A popular asymmetric encryption algorithm invented in 1977.

[b]One-Way Function[/b] - A mathematical operation that's easy to compute in one direction but extremely hard to reverse.

[b]Key Distribution Problem[/b] - The challenge of securely sharing secret keys over insecure networks. Asymmetric cryptography solves this!

[b]HTTPS[/b] - Secure web browsing that uses asymmetric encryption to protect your data.

[b]Digital Signature[/b] - Uses private key to prove you created a message (reverse of encryption).

[b]Certificate[/b] - A digital document containing a public key and information about its owner."
fit_content = true

