bbcode_enabled = true
text = "[b]Prevention Strategies:[/b]

✅ [b]Regular Backups:[/b] Keep offline backups of important files (3-2-1 rule: 3 copies, 2 different media, 1 offsite)

✅ [b]Email Awareness:[/b] Never open suspicious attachments or click unknown links

✅ [b]Software Updates:[/b] Keep your OS and all software up to date with security patches

✅ [b]Download Sources:[/b] Only download software from official, trusted sources

✅ [b]Antivirus Software:[/b] Use reputable antivirus with real-time protection

✅ [b]Network Security:[/b] Use firewalls and segment your network

✅ [b]User Permissions:[/b] Don't use administrator accounts for daily tasks

✅ [b]Education:[/b] Train yourself and others to recognize social engineering

[b]If Infected:[/b]
🔴 Disconnect from network immediately
🔴 Don't pay the ransom (no guarantee of file recovery)
🔴 Report to authorities
🔴 Restore from clean backups"
fit_content = true

