text = "� What is Encryption Auditing?"

[node name="Description" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/WhatIs"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "Encryption auditing is the process of reviewing cryptographic configurations to ensure data is properly protected. As a security analyst, you'll evaluate whether systems use strong algorithms (AES, Triple DES), proper modes of operation (CBC, GCM), adequate key lengths, and secure key management practices."
autowrap_mode = 3

[node name="Spacer1" type="Control" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox"]
