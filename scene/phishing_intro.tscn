theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 18
text = "� Key Concepts to Know:"

[node name="Flag1" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• AES (Advanced Encryption Standard): The gold standard — 128, 192, or 256-bit keys"
autowrap_mode = 3

[node name="Flag2" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• Triple DES (3DES/3TDEA): Three rounds of DES — 168-bit with 3 independent keys"
autowrap_mode = 3

[node name="Flag3" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• DES (Data Encryption Standard): Deprecated! Only 56-bit key — cracked in 1999"
autowrap_mode = 3

[node name="Flag4" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• ECB mode (Electronic Codebook): Leaks data patterns — avoid for structured data"
autowrap_mode = 3

[node name="Flag5" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• CBC mode (Cipher Block Chaining): Good with random IVs, needs MAC for authentication"
autowrap_mode = 3

[node name="Flag6" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• GCM mode (Galois/Counter Mode): Best choice — provides encryption AND authentication"
autowrap_mode = 3

