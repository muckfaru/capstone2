theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• Requests for personal information: Banks will NEVER ask for passwords via email"
autowrap_mode = 3

[node name="Flag5" type="Label" parent="ScrollContainer/MainContainer/VBox/ContentPanel/ContentMargin/ContentVBox/RedFlags"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.2, 0.2, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "• Suspicious links: Hover over links to see where they really go before clicking"
